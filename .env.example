# Copy to .env for local development. Do not commit real secrets.

# LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Research integrations
FIRECRAWL_API_KEY=
APIFY_TOKEN=
EXA_API_KEY=

# Optional browser / automation
N8N_WEBHOOK_URL=

# Local content engine
CONTENT_ENGINE_KMD_ROOT=knowledge/kmd

# Smoke policy
CONTENT_ENGINE_SMOKE_MODE=readonly
CONTENT_ENGINE_SMOKE_USER_ID=local-smoke-agent

# Optional stable public/read-only smoke fixtures.
# These must never point to production-write entities.
CONTENT_ENGINE_SMOKE_PUBLIC_ENTITY_ID=
CONTENT_ENGINE_SMOKE_PUBLIC_INVOICE_ID=
CONTENT_ENGINE_ENABLE_DANGEROUS_SMOKE=false
